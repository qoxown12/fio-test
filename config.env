# 공통 SSH 계정 (vm_list.txt의 모든 VM이 같은 계정을 사용)
REMOTE_USER='root'
REMOTE_PASSWORD='remote_password'
REMOTE_SSH_PORT=22
SSH_CONNECT_TIMEOUT=10

# yes: known_hosts에 등록된 호스트만 허용
# accept-new: 새 호스트 키는 등록하고, 변경된 키는 거부 (기본 권장)
# no: 호스트 키를 확인하지 않음
SSH_HOST_KEY_CHECKING='accept-new'

# 모든 VM의 파일 준비가 끝난 뒤 이 시간만큼 여유를 두고 동일 epoch에 fio 시작
# VM 수가 많거나 SSH 연결이 느리면 FIO_SYNC_START_DELAY를 늘릴 것
FIO_SYNC_START_DELAY=10
# 마스터와 원격 VM 간 허용할 최대 시스템 시각 차이(초)
FIO_MAX_CLOCK_SKEW=2

# 목록/결과 경로. 상대 경로는 이 도구 폴더를 기준으로 처리됨
VM_LIST_FILE='./vm_list.txt'
MASTER_RESULT_DIR='./results'
# report 프로그램이 각 결과 폴더에 생성할 CSV 파일명
REPORT_FILENAME='fio_summary.csv'

# 원격 VM에 fio 결과 로그를 먼저 저장할 경로
REMOTE_RESULT_DIR='/tmp/fio-test-results'
# yes면 마스터로 복제한 뒤에도 원격 결과 로그를 유지
KEEP_REMOTE_RESULTS='yes'

# single: 아래 FIO_RW/FIO_BS 한 항목 실행
# matrix: 항목마다 모든 VM을 동기 실행하고, 전체 완료 후 다음 항목 실행
TEST_MODE='single'

# fio 공통 기본값
# /data는 각 VM에서 별도 데이터 디스크로 마운트되어 있어야 함
FIO_DIRECTORY='/data/fio'
FIO_NAME='fio_test'
FIO_GTOD_REDUCE=1
FIO_RANDREPEAT=1
FIO_IOENGINE='libaio'
FIO_DIRECT=1
FIO_RW='randread'
FIO_BS='4k'
FIO_SIZE='1G'
# 고부하 기본값: VM당 최대 동시 I/O 상한은 16 x 64 = 1024
FIO_NUMJOBS=16
FIO_IODEPTH=64
FIO_RUNTIME=30
FIO_TIME_BASED='yes'
FIO_GROUP_REPORTING='yes'
FIO_NORANDOMMAP='yes'

# matrix 모드에서만 사용. 테스트마다 달라지는 rw와 bs만 지정
FIO_TEST_CASES=(
    'randread:4k'
    'randwrite:4k'
    'randread:8k'
    'randwrite:8k'
    'read:128k'
    'write:128k'
)
